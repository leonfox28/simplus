{
  "name": "@simplus/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "cross-env UMI_ENV=dev max dev",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "generate:components": "node -e \"console.log('React components are explicit imports')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts && tsc --noEmit && max build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@tanstack/react-query": "^5.101.4",
    "@umijs/max": "^4.7.0",
    "antd": "^6.5.3",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.6.1",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
  }
}
