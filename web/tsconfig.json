{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "paths": { "@/*": ["./src/*"] }, "types": ["node", "vite/client", "react", "react-dom", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "*.config.ts", "vite-env.d.ts"]
}
