{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true, "paths": { "@/*": ["./src/*"] }, "types": ["node", "react", "react-dom", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*.tsx", "src/api/**/*.ts", "src/locales/**/*.ts", "src/react-env.d.ts", "config/**/*.ts", ".umi/typings.d.ts"]
}
